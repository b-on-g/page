		sub /
			<= Render $mol_text
				text <= body_text \
	tools /
		<= Title_field $mol_string
			value? <=> title?
			hint @ \Title
		<= Edit_toggle $mol_check_icon
			hint @ \Toggle Edit
			checked? <=> editing? false
			Icon <= Edit_icon $mol_icon_pencil_outline
		<= Export $mol_pick
			hint @ \Export
			trigger_content /
				<= Export_icon $mol_icon_export
			bubble_content /
				<= Copy_md $mol_button_copy
					title @ \Copy as Markdown
					text <= body_text
				<= Copy_html $mol_button_copy
					title @ \Copy as HTML
					html <= body_html
				<= Download $mol_button_download
					title @ \Download .mt
					file_name <= download_name \page.mt
					blob <= download_blob $mol_blob
		<= Back $mol_button_minor
			click? <=> back? null
			hint @ \Back to list
			sub /
				<= Back_icon $mol_icon_arrow_left
	head /
		<= Title_field
		<= Edit_toggle
		<= Export
		<= Back

$mol_icon_plus $mol_icon path \M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z

$mol_icon_text $mol_icon path \M21,6V8H3V6H21M3,18H12V16H3V18M3,13H21V11H3V13Z

$bog_page_app $mol_view
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
			themes /
				\$mol_theme_calm_light
				\$mol_theme_calm_dark
	auto /
		<= ensure_default_page null
	sub /
		<= Sidebar $bog_ui_sidebar
			items <= sidebar_items /
		<= Editor_page $bog_page_side
			page_link <= current_page_link \
			back? <=> back_to_list? null
	Create_item $bog_ui_sidebar_item
		Icon <= Create_icon $mol_icon_plus
		label @ \+ New page
		click? <=> create? null
	- Radio $bog_blitz_radio
	Page_item* $bog_ui_sidebar_item
		Icon <= Page_icon* $mol_icon_text
		label <= page_title* \
		active <= page_active* false
		click? <=> open_page*? null
