$bog_page_app $mol_page
	title @ \page
	Title null
	tools /
		<= Sources $mol_link_source
			uri \https://github.com/b-on-g/page
		<= Status $giper_baza_status
		<= Theme_toggle $bog_theme_toggle
			theme_auto <= Theme
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
			themes /
				\$mol_theme_calm_light
				\$mol_theme_calm_dark
	body <= screen_body /
	Home $mol_page
		title @ \Pages
		tools /
			<= Create $mol_button_major
				title @ \+ New Page
				click? <=> create? null
		body /
			<= Empty_hint $mol_paragraph
				title @ \No pages yet. Click "+ New Page" to create one.
			<= Pages_list $mol_list
				rows <= page_rows /
	Page_card*0 $bog_page_card
		page_title <= page_title* \
		open? <=> open_page*? null
		delete? <=> delete_page*? null
	Editor*0 $bog_page_side
		page_link <= current_page_link \
		back? <=> back_to_list? null
